# ─────────────────────────────────────────────────────────────────────
# REQUERIDAS para que la API funcione
# ─────────────────────────────────────────────────────────────────────

# Anthropic API key (la que sacás de console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Secret para auth de la API. Generalo con: openssl rand -hex 32
# Este MISMO valor va en el frontend Lovable como RISKMANAGER_API_KEY.
API_SECRET=

# Orígenes permitidos por CORS (separados por comas).
# Agregá tu URL de Lovable production + dev/preview.
ALLOWED_ORIGINS=http://localhost:5173,https://tu-app.lovable.app

# ─────────────────────────────────────────────────────────────────────
# OPCIONALES — defaults razonables
# ─────────────────────────────────────────────────────────────────────

# Modelo de Claude. Default: claude-opus-4-7 (más capaz).
# Alternativas: claude-sonnet-4-6 (más barato), claude-haiku-4-5 (menos preciso).
ANTHROPIC_MODEL=claude-opus-4-7

# Max output tokens. Default 8000 — suficiente para audit + email + tablas.
ANTHROPIC_MAX_TOKENS=8000

# Si el reporte tiene MUCHOS trades, los truncamos antes de mandar al modelo
# para no saturar el context window. Las metrics se calculan en el frontend
# sobre el set completo, así que el cap no afecta exactitud.
MAX_TRADES_IN_PROMPT=300
