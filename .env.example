# ─────────────────────────────────────────────────────────────────────
# Anthropic — para el agente narrador (no necesario para /analyze)
# ─────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
AGENT_ID=
ENV_ID=

# ─────────────────────────────────────────────────────────────────────
# API config
# ─────────────────────────────────────────────────────────────────────
# Secret que el frontend Lovable debe enviar en header X-API-Key.
# Generá uno aleatorio: `openssl rand -hex 32`
API_SECRET=

# Orígenes permitidos por CORS, separados por comas.
# Para Lovable, agregá tu dominio de preview y producción.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080,https://tu-app.lovable.app
